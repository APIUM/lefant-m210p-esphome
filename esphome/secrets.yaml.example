# Copy to secrets.yaml and fill in. secrets.yaml is gitignored and must stay that way.
wifi_ssid: "YourSSID"
wifi_password: "your-wifi-password"

# Generate with: openssl rand -base64 32
lefant_api_key: "generate-your-own-32-byte-base64-key"

lefant_ota_password: "choose-an-ota-password"
lefant_ap_password: "choose-a-fallback-ap-password"
